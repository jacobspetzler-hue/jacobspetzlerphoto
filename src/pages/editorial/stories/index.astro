---
// Editorial → Stories: assignment work that didn't run on A1.
import Base from '../../../layouts/Base.astro';
import Img from '../../../components/Img.astro';
import { otherStories, dot } from '../../../lib/content';
import { fmtDate } from '../../../lib/media';

const stories = await otherStories();
---

<Base title="Stories" section="editorial" sub="stories">
  <div class="wrap page">
    <div class="page-head">
      <h1>Stories</h1>
      <p>Assignments and photo essays, with the pages they ran on where I have them.</p>
    </div>
    <div class="story-cards">
      {
        stories.map((s) => {
          const lead = s.data.photos?.[0]?.image || s.data.tearsheets?.[0]?.image;
          return (
            <a class="story-card" href={`/editorial/${s.id}/`}>
              <div class="label">{dot([s.data.publication, fmtDate(s.data.date)])}</div>
              <h2>{s.data.title}</h2>
              {lead && <Img src={lead} zoom={false} alt="" sizes="(max-width: 820px) 100vw, 380px" />}
              {s.data.summary && <p class="note">{s.data.summary}</p>}
            </a>
          );
        })
      }
    </div>
    {stories.length === 0 && <p class="empty">Stories to come.</p>}
  </div>
</Base>
