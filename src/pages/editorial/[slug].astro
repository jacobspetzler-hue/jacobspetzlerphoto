---
// One story. If it has a front page, the scan leads; otherwise the photos do.
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Rows from '../../components/Rows.astro';
import { allStories, frontPages, dot } from '../../lib/content';
import { fmtDate, items } from '../../lib/media';

export async function getStaticPaths() {
  const stories = await allStories();
  return stories.map((s) => ({ params: { slug: s.id }, props: { id: s.id } }));
}
const stories = await allStories();
const story = stories.find((s) => s.id === Astro.props.id)!;
const d = story.data;
const fronts = await frontPages();
const isFront = Boolean(d.front_page);
const i = fronts.findIndex((s) => s.id === story.id);
const prev = isFront && fronts.length > 1 ? fronts[(i - 1 + fronts.length) % fronts.length] : null;
const next = isFront && fronts.length > 1 ? fronts[(i + 1) % fronts.length] : null;
const tears = (d.tearsheets ?? []).filter((t) => t.image);
const photos = items(d.photos);
const clips = (d.clips ?? []).filter((c) => c.video);
const arrow = `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="5" y1="14" x2="22" y2="14"></line><polyline points="15,7 22,14 15,21"></polyline></svg>`;
const facts = [
  ['Publication', d.publication],
  ['Date', fmtDate(d.date)],
  ['Role', d.role],
  ['Placement', d.placement],
].filter(([, v]) => v);
---

<Base image={d.front_page || photos[0]?.image} title={d.title} description={d.summary || `${d.title} — ${d.publication}`} section="editorial" sub={isFront ? 'front-pages' : 'stories'}>
  <div class="wrap page">
    <a class="back" href={isFront ? '/editorial/' : '/editorial/stories/'}>← {isFront ? 'All front pages' : 'All stories'}</a>

    {
      isFront ? (
        <div class="story-top">
          <div class="scan" data-gallery>
            <Img src={d.front_page} page eager alt={`Front page of ${d.publication}, ${fmtDate(d.date)}`} caption={dot([d.publication, fmtDate(d.date), 'A1'])} sizes="(max-width: 820px) 100vw, 720px" />
            <div class="hint">
              <span>Select the page to open it, then click or pinch to zoom in and read</span>
            </div>
          </div>
          <aside class="story-aside">
            <h1>{d.title}</h1>
            <dl class="facts">
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
            {d.link && (
              <a class="button" href={d.link}>
                Read the story online <Fragment set:html={arrow} />
              </a>
            )}
            {prev && next && (
              <div class="prevnext">
                <a href={`/editorial/${prev.id}/`}>← Previous</a>
                <a href={`/editorial/${next.id}/`}>Next front page →</a>
              </div>
            )}
          </aside>
        </div>
      ) : (
        <div class="story-head">
          <div class="lead">
            <h1>{d.title}</h1>
            {d.summary && <p>{d.summary}</p>}
            {d.link && (
              <a class="button" href={d.link}>
                Read the story online <Fragment set:html={arrow} />
              </a>
            )}
          </div>
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {
      tears.length > 0 && (
        <section class="block">
          <h2 class="label-rule">{isFront ? 'Inside pages' : 'As published'}</h2>
          <div class="pages-strip scan" data-gallery>
            {tears.map((t) => (
              <figure>
                <Img src={t.image} page alt={`${d.publication}: ${t.label || 'page'}`} caption={dot([d.publication, t.label])} sizes="(max-width: 820px) 50vw, 280px" />
                {t.label && <figcaption>{t.label}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      photos.length > 0 && (
        <section class="block">
          <h2 class="label-rule">The photographs</h2>
          <Rows items={photos} large fallbackAlt={`Photograph from ${d.title}`} />
        </section>
      )
    }

    {
      clips.length > 0 && (
        <section class="block">
          <h2 class="label-rule">Moving images</h2>
          <div class="three-up">
            {clips.map((c) => (
              <video data-loop muted loop playsinline preload={c.poster ? "none" : "metadata"} poster={c.poster || undefined} aria-label={`Silent clip from ${d.title}`}>
                <source src={c.video} type="video/mp4" />
              </video>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
