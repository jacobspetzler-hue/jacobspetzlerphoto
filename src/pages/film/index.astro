---
// Film: one featured film at the top, the rest below.
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import Img from '../../components/Img.astro';
import { allFilms, dot } from '../../lib/content';

const films = await allFilms();
const featured = films.find((f) => f.data.featured) ?? films[0];
const rest = films.filter((f) => f !== featured);
const facts = featured
  ? [
      ['Client', featured.data.client],
      ['Year', featured.data.year],
      ['Runtime', featured.data.runtime],
      ['Role', featured.data.role],
    ].filter(([, v]) => v)
  : [];
const stills = (featured?.data.stills ?? []).filter((s) => s.image).slice(0, 3);
---

<Base title="Film" section="film" sub="films">
  <div class="wrap film">
    {
      featured ? (
        <section class="block">
          <Player title={featured.data.title} video={featured.data.video} poster={featured.data.poster} loop={featured.data.loop} tag="Film link to come" />
          <div class="film-info">
            <div class="lead">
              <h1>{featured.data.title}</h1>
              {featured.data.description && <p>{featured.data.description}</p>}
            </div>
            <dl class="facts inline">
              {facts.map(([k, v]) => (
                <div>
                  <dt class="quiet-text">{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
          {stills.length > 0 && (
            <div class="three-up" data-gallery>
              {stills.map((s) => <Img src={s.image} alt={s.alt} caption={s.caption} fallbackAlt={`Still from ${featured.data.title}`} sizes="(max-width: 820px) 50vw, 380px" />)}
            </div>
          )}
          <a class="button" style="align-self: flex-start" href={`/film/${featured.id}/`}>Stills &amp; full credits →</a>
        </section>
      ) : (
        <p class="empty">Films to come.</p>
      )
    }

    {
      rest.length > 0 && (
        <section class="block">
          <h2 class="label-rule">More films</h2>
          <div class="two-up">
            {rest.map((f) => (
              <a class="film-card" href={`/film/${f.id}/`}>
                <Player title={f.data.title} poster={f.data.poster} loop={f.data.loop} />
                <div class="row">
                  <strong>{f.data.title}</strong>
                  <span>{dot([f.data.client, f.data.year])}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
