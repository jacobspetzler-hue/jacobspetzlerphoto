---
// Film → Reel. Until there is a finished reel, this plays the homepage loop.
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { embedUrl } from '../../lib/media';

const home = (await getEntry('pages', 'home'))?.data as any;
const embed = embedUrl(home?.reel_link);
---

<Base title="Reel" section="film" sub="reel">
  <div class="wrap film">
    <section class="block">
      <div class="player">
        <video data-loop muted loop playsinline preload="metadata" poster={home?.loop_poster}>
          <source src={home?.loop_video} type="video/mp4" />
        </video>
        {
          embed && (
            <button class="play" type="button" data-embed={embed} data-title="Reel" aria-label="Play the reel">
              <svg aria-hidden="true" width="28" height="28" viewBox="0 0 28 28" fill="#f2f2ef"><polygon points="9,5 23,14 9,23" /></svg>
            </button>
          )
        }
      </div>
      <div class="film-info">
        <div class="lead">
          <h1>Reel</h1>
          {!embed && <p>A full reel is on the way. For now, a few silent moments from recent work.</p>}
        </div>
      </div>
    </section>
  </div>
</Base>
