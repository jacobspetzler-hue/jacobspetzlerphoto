---
// Shown when someone follows a link to a page that doesn't exist.
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="wrap page">
    <div class="page-head"><h1>Page not found</h1></div>
    <p class="empty">That page isn't here. Try <a class="underline" href="/editorial/">Editorial</a>, <a class="underline" href="/projects/">Projects</a> or <a class="underline" href="/film/">Film</a>.</p>
  </div>
</Base>
