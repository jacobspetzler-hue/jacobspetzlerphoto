---
// About: full bio, CV, client list and contact.
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');
const page = entry!.data as any;
const { Content } = await render(entry!);
const home = (await getEntry('pages', 'home'))?.data as any;
---

<Base title="About" section="about">
  <div class="wrap page">
    <div class="page-head"><h1>About</h1></div>
    <div class="about">
      <div class="bio prose">
        <Content />
      </div>
      <div class="side">
        {page.portrait && <Img src={page.portrait} zoom={false} alt="Portrait of Jacob Spetzler" sizes="(max-width: 820px) 100vw, 380px" />}
        <div class="contact">
          <div class="label">Contact</div>
          {home?.email && (home.email.includes('@') ? <a class="underline" href={`mailto:${home.email}`}>{home.email}</a> : <span>{home.email}</span>)}
          {home?.instagram && <a href={`https://www.instagram.com/${String(home.instagram).replace('@', '')}/`}>{home.instagram}</a>}
          <span class="quiet-text">{home?.availability}</span>
          {page.cv_pdf && <a class="button small" href={page.cv_pdf}>Download CV (PDF)</a>}
        </div>
      </div>
      <div class="cv">
        {
          (page.cv ?? []).map((group: any) => (
            <section>
              <h2>{group.heading}</h2>
              <ul>{(group.items ?? []).map((i: string) => <li>{i}</li>)}</ul>
            </section>
          ))
        }
        {
          (page.clients ?? []).length > 0 && (
            <section>
              <h2>Editorial clients</h2>
              <ul>{page.clients.map((c: string) => <li>{c}</li>)}</ul>
            </section>
          )
        }
      </div>
    </div>
  </div>
</Base>
