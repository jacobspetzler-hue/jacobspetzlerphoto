---
// Even rows of photos. Each photo keeps its own shape; nothing is cropped.
import Img from './Img.astro';
import { picture } from '../lib/media';

interface Item {
  image?: string | null;
  caption?: string | null;
  alt?: string | null;
}
interface Props {
  items: Item[];
  large?: boolean;
  fallbackAlt?: string;
}
const { items, large = false, fallbackAlt = '' } = Astro.props;
const ready = (
  await Promise.all(items.map(async (it) => ({ it, pic: await picture(it.image) })))
).filter((x) => x.pic);
---

<div class:list={['rows', { large }]} data-gallery>
  {
    ready.map(({ it, pic }) => (
      <figure class="cell" style={`--r:${pic!.ratio.toFixed(4)}`}>
        <Img src={it.image} alt={it.alt} caption={it.caption} fallbackAlt={fallbackAlt} sizes={large ? '(max-width: 820px) 60vw, 45vw' : '(max-width: 820px) 50vw, 30vw'} />
      </figure>
    ))
  }
</div>
